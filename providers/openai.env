# OpenAI GPT: OpenAI has no Anthropic-protocol endpoint, so a local LiteLLM proxy
# translates Claude Code's Anthropic Messages requests into OpenAI API calls.
# CCX_LITELLM_PORT turns that on: ccx starts the proxy in the background on first
# use (LiteLLM from the conda env in environment.yml, config openai.litellm.yaml)
# and reuses it afterwards.
# Reference: https://docs.litellm.ai/docs/tutorials/claude_non_anthropic_models

CCX_KEY=OPENAI_API_KEY           # env var holding the key; only the proxy receives it
CCX_MODEL=gpt-6.1-sol            # any OpenAI model ID; the proxy routes every name to OpenAI
CCX_SMALL_MODEL=gpt-6-luna
CCX_LITELLM_PORT=4000            # one port per LiteLLM-backed provider

# Claude Code does not know GPT model IDs; both models take 922k input tokens
# (LiteLLM's model map). Plain digits only.
CLAUDE_CODE_MAX_CONTEXT_TOKENS=922000
