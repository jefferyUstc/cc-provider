# To add a provider: copy this to providers/<command-name>.env, edit the lines
# below, then run ./install.sh again. Files starting with _ are not installed.

CCX_KEY=EXAMPLE_API_KEY          # NAME of the env var holding the key, never the key itself
CCX_MODEL=example-large          # main model
CCX_SMALL_MODEL=example-small    # optional: haiku alias and background tasks

# Either: the provider's Anthropic Messages-compatible endpoint (many have one,
# often ending in /anthropic; check their docs). Claude Code appends /v1/messages.
ANTHROPIC_BASE_URL=https://api.example.com/anthropic

# Or, for an OpenAI-protocol-only provider: a local LiteLLM proxy instead of
# ANTHROPIC_BASE_URL. Pick an unused port and copy openai.litellm.yaml to
# <command-name>.litellm.yaml (LiteLLM prefix and key variable); see openai.env.
# CCX_LITELLM_PORT=4001

# The model's context window when it is not 1M tokens (plain digits).
# CLAUDE_CODE_MAX_CONTEXT_TOKENS=200000
