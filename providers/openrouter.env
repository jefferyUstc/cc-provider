# OpenRouter: one key for many vendors' models (Grok, GPT, Gemini, DeepSeek, ...)
# behind an Anthropic Messages-compatible endpoint; direct connection, no proxy.
# Docs: https://openrouter.ai/docs/cookbook/coding-agents/claude-code-integration
# OpenRouter only guarantees Claude Code with Anthropic models; how well another
# model works depends on how it handles Claude Code's tool calls.

CCX_KEY=OPENROUTER_API_KEY       # env var holding the key
CCX_MODEL=x-ai/grok-4.7          # any slug from https://openrouter.ai/models
CCX_SMALL_MODEL=x-ai/grok-4.1-fast

# No /v1 here: that path is OpenRouter's OpenAI-protocol API.
ANTHROPIC_BASE_URL=https://openrouter.ai/api

# Conservative default (plain digits); raise it to the context window of the
# models you use.
CLAUDE_CODE_MAX_CONTEXT_TOKENS=200000
