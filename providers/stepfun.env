# StepFun: official Anthropic Messages-compatible endpoint, direct connection, no proxy.
# Docs: https://platform.stepfun.ai/docs/en/step-plan/integrations/claude-code

CCX_KEY=STEPFUN_API_KEY          # env var holding the key (export it in ~/.zshrc)
CCX_MODEL=step-5-preview         # main model: opus/sonnet/fable aliases and subagents map here
CCX_SMALL_MODEL=step-3.7-flash   # small model: haiku alias and background tasks

# Step Plan endpoint. Claude Code appends /v1/messages itself, so do not add /v1.
# This is for international-site keys (stepfun.ai); China-site keys need
# https://api.stepfun.com/step_plan instead. For pay-as-you-go billing drop the
# /step_plan suffix; the two quotas are separate.
ANTHROPIC_BASE_URL=https://api.stepfun.ai/step_plan

# Claude Code does not know third-party model IDs, so tell it the context window
# (plain digits only); auto-compaction follows it.
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000

# Optional: fully separate history, settings and MCP from `claude`
# (cost: skills, hooks and CLAUDE.md are no longer shared).
# CLAUDE_CONFIG_DIR=$HOME/.claude-stepfun
